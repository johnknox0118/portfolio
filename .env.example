# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Configure these on Vercel / Production Host)
# =============================================================================

# PostgreSQL Database Connection (e.g. Supabase, Neon, Railway, AWS RDS)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# JWT Secret for Admin Dashboard Authentication
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Public Application URL (without trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage & Database Integration (Optional for image hosting)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Google Gemini API Key for J.A.M.S. Cyber AI Assistant (Get free at https://aistudio.google.com/)
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
